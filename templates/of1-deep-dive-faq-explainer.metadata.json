{
  "name": "of1-deep-dive-faq-explainer",
  "intent": "deep-dive",
  "description": "Tabbed explainer plus a 4-5 item FAQ accordion for question-driven deep dives.",
  "minItems": 4,
  "maxItems": 5,
  "stylesheet": "/styles/of1-deep-dive-faq-explainer.css",
  "html": "/templates/of1-deep-dive-faq-explainer.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label above the headline, 1-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline framing this as an explainer, <=10 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-2 sentence expansion of the headline" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "Primary call to action, e.g. jump to FAQs" },
    { "key": "hero.image", "type": "image", "instruction": "Hero image URL representative of the topic" },
    { "key": "tabs.title", "type": "text", "instruction": "Heading above the tabbed section" },
    { "key": "tab-1.label", "type": "text", "instruction": "Tab 1 short label, 1-2 words" },
    { "key": "tab-1.title", "type": "text", "instruction": "Tab 1 panel heading" },
    { "key": "tab-1.body", "type": "text", "instruction": "Tab 1 panel body, 2-3 sentences" },
    { "key": "tab-2.label", "type": "text", "instruction": "Tab 2 short label, 1-2 words" },
    { "key": "tab-2.title", "type": "text", "instruction": "Tab 2 panel heading" },
    { "key": "tab-2.body", "type": "text", "instruction": "Tab 2 panel body, 2-3 sentences" },
    { "key": "tab-3.label", "type": "text", "instruction": "Tab 3 short label, 1-2 words" },
    { "key": "tab-3.title", "type": "text", "instruction": "Tab 3 panel heading" },
    { "key": "tab-3.body", "type": "text", "instruction": "Tab 3 panel body, 2-3 sentences" },
    { "key": "faq.title", "type": "text", "instruction": "Heading above the FAQ accordion" },
    { "key": "item-1.title", "type": "text", "instruction": "FAQ question 1" },
    { "key": "item-1.body", "type": "text", "instruction": "FAQ answer 1, 1-2 sentences" },
    { "key": "item-2.title", "type": "text", "instruction": "FAQ question 2" },
    { "key": "item-2.body", "type": "text", "instruction": "FAQ answer 2, 1-2 sentences" },
    { "key": "item-3.title", "type": "text", "instruction": "FAQ question 3" },
    { "key": "item-3.body", "type": "text", "instruction": "FAQ answer 3, 1-2 sentences" },
    { "key": "item-4.title", "type": "text", "instruction": "FAQ question 4" },
    { "key": "item-4.body", "type": "text", "instruction": "FAQ answer 4, 1-2 sentences" },
    { "key": "item-5.title", "type": "text", "instruction": "FAQ question 5" },
    { "key": "item-5.body", "type": "text", "instruction": "FAQ answer 5, 1-2 sentences" },
    { "key": "cta.title", "type": "text", "instruction": "Closing headline, <=8 words" },
    { "key": "cta.body", "type": "text", "instruction": "1 sentence closing supporting line" },
    { "key": "cta.cta", "type": "link", "instruction": "Final call-to-action link" }
  ]
}
