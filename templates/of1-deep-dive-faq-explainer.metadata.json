{
  "name": "of1-deep-dive-faq-explainer",
  "intent": "deep-dive",
  "description": "Tabbed overview/how-it-works/security explainer plus a fact grid and an FAQ accordion.",
  "minItems": 3,
  "maxItems": 4,
  "stylesheet": "/styles/of1-deep-dive-faq-explainer.css",
  "html": "/templates/of1-deep-dive-faq-explainer.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Small label above title, e.g. 'Deep dive', 2-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline phrased as a question or topic, <=8 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-sentence framing of what this explains" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "Primary CTA to the product page" },
    { "key": "tab-1.label", "type": "text", "instruction": "Tab label, 1-2 words, e.g. 'Overview'" },
    { "key": "tab-1.body", "type": "text", "instruction": "2-3 sentence panel content for tab 1" },
    { "key": "tab-2.label", "type": "text", "instruction": "Tab label, 1-2 words, e.g. 'How it works'" },
    { "key": "tab-2.body", "type": "text", "instruction": "2-3 sentence panel content for tab 2" },
    { "key": "tab-3.label", "type": "text", "instruction": "Tab label, 1-2 words, e.g. 'Security'" },
    { "key": "tab-3.body", "type": "text", "instruction": "2-3 sentence panel content for tab 3" },
    { "key": "facts.title", "type": "text", "instruction": "Section heading, e.g. 'At a glance'" },
    { "key": "item-1.title", "type": "text", "instruction": "Fact label, <=5 words" },
    { "key": "item-1.body", "type": "text", "instruction": "1-sentence supporting detail" },
    { "key": "item-2.title", "type": "text", "instruction": "Fact label, <=5 words" },
    { "key": "item-2.body", "type": "text", "instruction": "1-sentence supporting detail" },
    { "key": "item-3.title", "type": "text", "instruction": "Fact label, <=5 words" },
    { "key": "item-3.body", "type": "text", "instruction": "1-sentence supporting detail" },
    { "key": "faq.title", "type": "text", "instruction": "Section heading, e.g. 'Frequently asked questions'" },
    { "key": "faq-1.question", "type": "text", "instruction": "FAQ question" },
    { "key": "faq-1.answer", "type": "text", "instruction": "1-2 sentence answer" },
    { "key": "faq-2.question", "type": "text", "instruction": "FAQ question" },
    { "key": "faq-2.answer", "type": "text", "instruction": "1-2 sentence answer" },
    { "key": "faq-3.question", "type": "text", "instruction": "FAQ question" },
    { "key": "faq-3.answer", "type": "text", "instruction": "1-2 sentence answer" },
    { "key": "faq-4.question", "type": "text", "instruction": "FAQ question" },
    { "key": "faq-4.answer", "type": "text", "instruction": "1-2 sentence answer" },
    { "key": "cta.title", "type": "text", "instruction": "Closing headline, <=6 words" },
    { "key": "cta.link", "type": "link", "instruction": "Closing call-to-action link and label" }
  ]
}
