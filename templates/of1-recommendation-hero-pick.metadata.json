{
  "name": "of1-recommendation-hero-pick",
  "intent": "recommendation",
  "description": "Single best-match hero pick with a large product spotlight, reasons it fits, and a grid of alternatives.",
  "minItems": 2,
  "maxItems": 4,
  "stylesheet": "/styles/of1-recommendation-hero-pick.css",
  "html": "/templates/of1-recommendation-hero-pick.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label, 2-4 words, e.g. 'Personalized recommendation'" },
    { "key": "hero.title", "type": "text", "instruction": "Headline, <=8 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-2 sentence framing of the recommendation" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "Primary CTA to the top pick" },
    { "key": "pick.image", "type": "image", "instruction": "Hero image of the recommended product" },
    { "key": "pick.badge", "type": "text", "instruction": "Short badge, e.g. 'Best match for you'" },
    { "key": "pick.title", "type": "text", "instruction": "Recommended product name" },
    { "key": "pick.description", "type": "text", "instruction": "2-3 sentence description of the recommended product" },
    { "key": "pick.feature-1", "type": "text", "instruction": "Short feature bullet" },
    { "key": "pick.feature-2", "type": "text", "instruction": "Short feature bullet" },
    { "key": "pick.feature-3", "type": "text", "instruction": "Short feature bullet" },
    { "key": "pick.price", "type": "text", "instruction": "Price line, e.g. 'From $17/month'" },
    { "key": "pick.cta", "type": "link", "instruction": "CTA to the recommended product page" },
    { "key": "reason-1.title", "type": "text", "instruction": "Short reason title, <=5 words" },
    { "key": "reason-1.body", "type": "text", "instruction": "1-sentence explanation" },
    { "key": "reason-2.title", "type": "text", "instruction": "Short reason title, <=5 words" },
    { "key": "reason-2.body", "type": "text", "instruction": "1-sentence explanation" },
    { "key": "reason-3.title", "type": "text", "instruction": "Short reason title, <=5 words" },
    { "key": "reason-3.body", "type": "text", "instruction": "1-sentence explanation" },
    { "key": "item-1.image", "type": "image", "instruction": "Alternative product image" },
    { "key": "item-1.title", "type": "text", "instruction": "Alternative product name" },
    { "key": "item-1.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-1.cta", "type": "link", "instruction": "Link to the alternative product" },
    { "key": "item-2.image", "type": "image", "instruction": "Alternative product image" },
    { "key": "item-2.title", "type": "text", "instruction": "Alternative product name" },
    { "key": "item-2.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-2.cta", "type": "link", "instruction": "Link to the alternative product" },
    { "key": "item-3.image", "type": "image", "instruction": "Alternative product image" },
    { "key": "item-3.title", "type": "text", "instruction": "Alternative product name" },
    { "key": "item-3.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-3.cta", "type": "link", "instruction": "Link to the alternative product" },
    { "key": "item-4.image", "type": "image", "instruction": "Alternative product image" },
    { "key": "item-4.title", "type": "text", "instruction": "Alternative product name" },
    { "key": "item-4.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-4.cta", "type": "link", "instruction": "Link to the alternative product" },
