{
  "name": "of1-recommendation-hero-pick",
  "intent": "recommendation",
  "description": "Single hero-featured top pick with a reasons-why breakdown and a secondary grid of alternates.",
  "minItems": 2,
  "maxItems": 4,
  "stylesheet": "/styles/of1-recommendation-hero-pick.css",
  "html": "/templates/of1-recommendation-hero-pick.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label, e.g. 'Personalized for you', 2-4 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline naming the personalization angle, <=10 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-sentence framing of how the pick was chosen" },
    { "key": "hero.cta", "type": "link", "instruction": "Primary call to action" },
    { "key": "hero.image", "type": "image", "instruction": "Hero image URL relevant to the recommendation theme" },
    { "key": "pick.badge", "type": "text", "instruction": "Short badge, e.g. 'Top pick for you', 2-4 words" },
    { "key": "pick.eyebrow", "type": "text", "instruction": "1 short line stating the basis for the recommendation" },
    { "key": "pick.image", "type": "image", "instruction": "Image representing the recommended item" },
    { "key": "pick.title", "type": "text", "instruction": "Name of the recommended item/combo, <=8 words" },
    { "key": "pick.body", "type": "text", "instruction": "1-2 sentence explanation of what it is and why it fits" },
    { "key": "pick.meta", "type": "text", "instruction": "Short meta line, e.g. duration and offline note" },
    { "key": "pick.cta", "type": "link", "instruction": "CTA to start/try the recommended item" },
    { "key": "reasons.title", "type": "text", "instruction": "Section headline, e.g. 'Why we picked this for you'" },
    { "key": "reason-1.title", "type": "text", "instruction": "Short reason title, <=5 words" },
    { "key": "reason-1.body", "type": "text", "instruction": "1-sentence justification" },
    { "key": "reason-2.title", "type": "text", "instruction": "Short reason title, <=5 words" },
    { "key": "reason-2.body", "type": "text", "instruction": "1-sentence justification" },
    { "key": "reason-3.title", "type": "text", "instruction": "Short reason title, <=5 words" },
    { "key": "reason-3.body", "type": "text", "instruction": "1-sentence justification" },
    { "key": "alt.title", "type": "text", "instruction": "Section headline for alternates, e.g. 'Other options worth trying'" },
    { "key": "item-1.image", "type": "image", "instruction": "Alternate item image" },
    { "key": "item-1.title", "type": "text", "instruction": "Alternate item name, <=6 words" },
    { "key": "item-1.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-1.cta", "type": "link", "instruction": "Link to try the alternate" },
    { "key": "item-2.image", "type": "image", "instruction": "Alternate item image" },
    { "key": "item-2.title", "type": "text", "instruction": "Alternate item name, <=6 words" },
    { "key": "item-2.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-2.cta", "type": "link", "instruction": "Link to try the alternate" },
    { "key": "item-3.image", "type": "image", "instruction": "Alternate item image" },
    { "key": "item-3.title", "type": "text", "instruction": "Alternate item name, <=6 words" },
    { "key": "item-3.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-3.cta", "type": "link", "instruction": "Link to try the alternate" },
    { "key": "item-4.image", "type": "image", "instruction": "Alternate item image" },
    { "key": "item-4.title", "type": "text", "instruction": "Alternate item name, <=6 words" },
    { "key": "item-4.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-4.cta", "type": "link", "instruction": "Link to try the alternate" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline, <=8 words" },
    { "key": "cta.subtitle", "type": "text", "instruction": "1-sentence supporting line" },
    { "key": "cta.button", "type": "link", "instruction": "Final CTA button" }
  ]
