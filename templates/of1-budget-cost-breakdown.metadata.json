{
  "name": "of1-budget-cost-breakdown",
  "intent": "budget",
  "description": "Itemized annual-cost comparison table vs. competitor subscriptions, with a savings callout.",
  "minItems": 2,
  "maxItems": 6,
  "stylesheet": "/styles/of1-budget-cost-breakdown.css",
  "html": "/templates/of1-budget-cost-breakdown.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Small label above headline, 1-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline framing cost comparison, <=10 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-2 sentence supporting line" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "Primary CTA label + link" },
    { "key": "hero.image", "type": "image", "instruction": "Hero product image URL" },
    { "key": "table.title", "type": "text", "instruction": "Comparison table headline, <=6 words" },
    { "key": "table.subtitle", "type": "text", "instruction": "1 sentence explaining the comparison basis" },
    { "key": "table.col-1", "type": "text", "instruction": "Column 1 header, 1-2 words" },
    { "key": "table.col-2", "type": "text", "instruction": "Column 2 header, 1-2 words" },
    { "key": "table.col-3", "type": "text", "instruction": "Column 3 header, 1-2 words" },
    { "key": "item-1.title", "type": "text", "instruction": "Competitor/row name" },
    { "key": "item-1.body", "type": "text", "instruction": "Plan name, short" },
    { "key": "item-1.price", "type": "text", "instruction": "Annual cost, short (e.g. $69.99)" },
    { "key": "item-2.title", "type": "text", "instruction": "Competitor/row name" },
    { "key": "item-2.body", "type": "text", "instruction": "Plan name, short" },
    { "key": "item-2.price", "type": "text", "instruction": "Annual cost, short" },
    { "key": "item-3.title", "type": "text", "instruction": "Competitor/row name" },
    { "key": "item-3.body", "type": "text", "instruction": "Plan name, short" },
    { "key": "item-3.price", "type": "text", "instruction": "Annual cost, short" },
    { "key": "item-4.title", "type": "text", "instruction": "This brand's row name" },
    { "key": "item-4.body", "type": "text", "instruction": "Plan name, short (e.g. Free forever)" },
    { "key": "item-4.price", "type": "text", "instruction": "Annual cost, short (e.g. $0)" },
    { "key": "savings.eyebrow", "type": "text", "instruction": "Small label, 1-3 words" },
    { "key": "savings.stat", "type": "text", "instruction": "Large stat line, <=4 words (e.g. $0 spent)" },
    { "key": "savings.body", "type": "text", "instruction": "1-2 sentence explanation of the savings" },
    { "key": "included.title", "type": "text", "instruction": "Headline for included-features list, <=8 words" },
    { "key": "included.items", "type": "list", "instruction": "3-6 short feature bullets" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline, <=8 words" },
    { "key": "cta.subtitle", "type": "text", "instruction": "1 sentence closing line" },
    { "key": "cta.cta-primary", "type": "link", "instruction": "Closing CTA label + link" }
  ]
}
