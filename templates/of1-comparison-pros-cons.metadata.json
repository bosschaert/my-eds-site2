{
  "name": "of1-comparison-pros-cons",
  "intent": "comparison",
  "description": "Tabbed pros/cons breakdown for 2-3 options — one detailed panel visible at a time, switchable via pill tabs.",
  "minItems": 2,
  "maxItems": 3,
  "stylesheet": "/styles/of1-comparison-pros-cons.css",
  "html": "/templates/of1-comparison-pros-cons.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label above the title, 1-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline, <=8 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-sentence framing of the tradeoffs being compared" },
    { "key": "item-1.image", "type": "image", "instruction": "Image URL for option 1" },
    { "key": "item-1.subtitle", "type": "text", "instruction": "Category label, 1-3 words" },
    { "key": "item-1.title", "type": "text", "instruction": "Name of option 1" },
    { "key": "item-1.price", "type": "text", "instruction": "Starting price string" },
    { "key": "item-1.pros", "type": "list", "instruction": "3-4 short strengths" },
    { "key": "item-1.cons", "type": "list", "instruction": "2-3 short tradeoffs" },
    { "key": "item-1.cta", "type": "link", "instruction": "Link to option 1's page" },
    { "key": "item-2.image", "type": "image", "instruction": "Image URL for option 2" },
    { "key": "item-2.subtitle", "type": "text", "instruction": "Category label, 1-3 words" },
    { "key": "item-2.title", "type": "text", "instruction": "Name of option 2" },
    { "key": "item-2.price", "type": "text", "instruction": "Starting price string" },
    { "key": "item-2.pros", "type": "list", "instruction": "3-4 short strengths" },
    { "key": "item-2.cons", "type": "list", "instruction": "2-3 short tradeoffs" },
    { "key": "item-2.cta", "type": "link", "instruction": "Link to option 2's page" },
    { "key": "item-3.image", "type": "image", "instruction": "Image URL for option 3" },
    { "key": "item-3.subtitle", "type": "text", "instruction": "Category label, 1-3 words" },
    { "key": "item-3.title", "type": "text", "instruction": "Name of option 3" },
    { "key": "item-3.price", "type": "text", "instruction": "Starting price string" },
    { "key": "item-3.pros", "type": "list", "instruction": "3-4 short strengths" },
    { "key": "item-3.cons", "type": "list", "instruction": "2-3 short tradeoffs" },
    { "key": "item-3.cta", "type": "link", "instruction": "Link to option 3's page" },
    { "key": "summary.title", "type": "text", "instruction": "Section heading, e.g. 'Quick summary'" },
    { "key": "summary.points", "type": "list", "instruction": "3-4 one-line takeaways across all options" },
    { "key": "cta.title", "type": "text", "instruction": "Closing headline, <=6 words" },
    { "key": "cta.subtitle", "type": "text", "instruction": "1-sentence supporting line" },
    { "key": "cta.cta-primary", "type": "link", "instruction": "Final CTA label + link" }
  ]
}
