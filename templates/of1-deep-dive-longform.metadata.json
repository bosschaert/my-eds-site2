{
  "name": "of1-deep-dive-longform",
  "intent": "deep-dive",
  "description": "Editorial longform explainer with alternating image/text splits and a numbered 4-step flow.",
  "minItems": 4,
  "maxItems": 4,
  "stylesheet": "/styles/of1-deep-dive-longform.css",
  "html": "/templates/of1-deep-dive-longform.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label above the headline, 1-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline explaining what this deep dive covers, <=10 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-2 sentence expansion of the headline" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "Primary call to action, e.g. 'Explore the science'" },
    { "key": "hero.image", "type": "image", "instruction": "Hero image URL representative of the topic" },
    { "key": "lead.eyebrow", "type": "text", "instruction": "Short label, e.g. 'Why it works'" },
    { "key": "lead.body", "type": "text", "instruction": "1-2 sentence pull-quote style lead paragraph, larger type" },
    { "key": "split-1.eyebrow", "type": "text", "instruction": "Short numbered label, e.g. '01 — The physiology'" },
    { "key": "split-1.title", "type": "text", "instruction": "Subheading for the first explanatory section" },
    { "key": "split-1.body", "type": "text", "instruction": "2-3 sentence explanation" },
    { "key": "split-1.image", "type": "image", "instruction": "Supporting image URL for the first section" },
    { "key": "split-2.eyebrow", "type": "text", "instruction": "Short numbered label, e.g. '02 — The rhythms'" },
    { "key": "split-2.title", "type": "text", "instruction": "Subheading for the second explanatory section" },
    { "key": "split-2.body", "type": "text", "instruction": "2-3 sentence explanation" },
    { "key": "split-2.image", "type": "image", "instruction": "Supporting image URL for the second section" },
    { "key": "steps.title", "type": "text", "instruction": "Heading for the step-by-step flow section" },
    { "key": "steps.subtitle", "type": "text", "instruction": "1 sentence subtitle" },
    { "key": "item-1.title", "type": "text", "instruction": "Step 1 short title" },
    { "key": "item-1.body", "type": "text", "instruction": "Step 1 short description" },
    { "key": "item-2.title", "type": "text", "instruction": "Step 2 short title" },
    { "key": "item-2.body", "type": "text", "instruction": "Step 2 short description" },
    { "key": "item-3.title", "type": "text", "instruction": "Step 3 short title" },
    { "key": "item-3.body", "type": "text", "instruction": "Step 3 short description" },
    { "key": "item-4.title", "type": "text", "instruction": "Step 4 short title" },
    { "key": "item-4.body", "type": "text", "instruction": "Step 4 short description" },
    { "key": "cta.title", "type": "text", "instruction": "Closing headline, <=8 words" },
    { "key": "cta.body", "type": "text", "instruction": "1 sentence closing supporting line" },
    { "key": "cta.cta", "type": "link", "instruction": "Final call-to-action link" }
  ]
}
