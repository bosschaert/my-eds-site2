{
  "name": "of1-deep-dive-longform",
  "intent": "deep-dive",
  "description": "Single-column editorial explainer: overview + fact list, capability grid, pull-quote essay, related reading.",
  "minItems": 3,
  "maxItems": 4,
  "stylesheet": "/styles/of1-deep-dive-longform.css",
  "html": "/templates/of1-deep-dive-longform.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Small label above title, e.g. 'Deep dive', 2-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline naming the product/topic, <=8 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-sentence framing of what this explains" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "Primary CTA to the product page" },
    { "key": "hero.image", "type": "image", "instruction": "Representative product image URL" },
    { "key": "overview.title", "type": "text", "instruction": "Section heading, e.g. 'What it is', <=4 words" },
    { "key": "overview.body-1", "type": "text", "instruction": "1-2 sentence explanation, plain language" },
    { "key": "overview.body-2", "type": "text", "instruction": "1-2 sentence follow-up detail" },
    { "key": "fact-1.label", "type": "text", "instruction": "Spec label, e.g. 'Platform'" },
    { "key": "fact-1.value", "type": "text", "instruction": "Spec value" },
    { "key": "fact-2.label", "type": "text", "instruction": "Spec label, e.g. 'Pricing'" },
    { "key": "fact-2.value", "type": "text", "instruction": "Spec value" },
    { "key": "fact-3.label", "type": "text", "instruction": "Spec label, e.g. 'Best for'" },
    { "key": "fact-3.value", "type": "text", "instruction": "Spec value" },
    { "key": "fact-4.label", "type": "text", "instruction": "Spec label, e.g. 'Category'" },
    { "key": "fact-4.value", "type": "text", "instruction": "Spec value" },
    { "key": "capabilities.title", "type": "text", "instruction": "Section heading, e.g. 'Key capabilities'" },
    { "key": "item-1.title", "type": "text", "instruction": "Capability name, <=5 words" },
    { "key": "item-1.body", "type": "text", "instruction": "1-sentence capability description" },
    { "key": "item-2.title", "type": "text", "instruction": "Capability name, <=5 words" },
    { "key": "item-2.body", "type": "text", "instruction": "1-sentence capability description" },
    { "key": "item-3.title", "type": "text", "instruction": "Capability name, <=5 words" },
    { "key": "item-3.body", "type": "text", "instruction": "1-sentence capability description" },
    { "key": "item-4.title", "type": "text", "instruction": "Capability name, <=5 words" },
    { "key": "item-4.body", "type": "text", "instruction": "1-sentence capability description" },
    { "key": "explainer.title", "type": "text", "instruction": "Section heading, e.g. 'Under the hood'" },
    { "key": "explainer.body-1", "type": "text", "instruction": "2-3 sentence deeper explanation paragraph" },
    { "key": "quote.text", "type": "text", "instruction": "Real customer/testimonial quote, 1-2 sentences" },
    { "key": "quote.author", "type": "text", "instruction": "Quote author name" },
    { "key": "quote.role", "type": "text", "instruction": "Author role and company" },
    { "key": "explainer.body-2", "type": "text", "instruction": "2-3 sentence closing explanation paragraph" },
    { "key": "related.title", "type": "text", "instruction": "Section heading, e.g. 'Go deeper'" },
    { "key": "related-1", "type": "link", "instruction": "Related resource link and label" },
    { "key": "related-2", "type": "link", "instruction": "Related resource link and label" },
    { "key": "related-3", "type": "link", "instruction": "Related resource link and label" },
    { "key": "cta.final", "type": "link", "instruction": "Closing call-to-action link and label" }
  ]
}
