{
  "name": "of1-deep-dive-timeline",
  "intent": "deep-dive",
  "description": "Vertical timeline walking through 3-5 sequential steps of a process, plus a dark facts panel.",
  "minItems": 3,
  "maxItems": 5,
  "stylesheet": "/styles/of1-deep-dive-timeline.css",
  "html": "/templates/of1-deep-dive-timeline.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label above the headline, 1-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline framing this as a step-by-step explanation, <=10 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-2 sentence expansion of the headline" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "Primary call to action" },
    { "key": "hero.image", "type": "image", "instruction": "Hero image URL representative of the topic" },
    { "key": "intro.title", "type": "text", "instruction": "Short intro heading" },
    { "key": "intro.body", "type": "text", "instruction": "1-2 sentence introduction to the timeline" },
    { "key": "item-1.title", "type": "text", "instruction": "Timeline step 1 title" },
    { "key": "item-1.body", "type": "text", "instruction": "Timeline step 1 description" },
    { "key": "item-2.title", "type": "text", "instruction": "Timeline step 2 title" },
    { "key": "item-2.body", "type": "text", "instruction": "Timeline step 2 description" },
    { "key": "item-3.title", "type": "text", "instruction": "Timeline step 3 title" },
    { "key": "item-3.body", "type": "text", "instruction": "Timeline step 3 description" },
    { "key": "item-4.title", "type": "text", "instruction": "Timeline step 4 title" },
    { "key": "item-4.body", "type": "text", "instruction": "Timeline step 4 description" },
    { "key": "item-5.title", "type": "text", "instruction": "Timeline step 5 title" },
    { "key": "item-5.body", "type": "text", "instruction": "Timeline step 5 description" },
    { "key": "facts.title", "type": "text", "instruction": "Heading for the supporting facts panel" },
    { "key": "facts.body", "type": "text", "instruction": "1-2 sentence supporting copy" },
    { "key": "facts.list", "type": "list", "instruction": "3-5 short standalone facts or stats, one per line" },
    { "key": "cta.title", "type": "text", "instruction": "Closing headline, <=8 words" },
    { "key": "cta.body", "type": "text", "instruction": "1 sentence closing supporting line" },
    { "key": "cta.cta", "type": "link", "instruction": "Final call-to-action link" }
  ]
}
