{
  "name": "of1-comparison-versus",
  "intent": "comparison",
  "description": "Head-to-head split layout for exactly 2 options with a VS divider, pros/cons columns, and a verdict callout.",
  "minItems": 2,
  "maxItems": 2,
  "stylesheet": "/styles/of1-comparison-versus.css",
  "html": "/templates/of1-comparison-versus.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label above the title, 1-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline naming both options, e.g. 'Claude Code vs. Claude Cowork'" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-sentence framing of the comparison" },
    { "key": "item-1.image", "type": "image", "instruction": "Image URL for option A" },
    { "key": "item-1.subtitle", "type": "text", "instruction": "Category label for option A, 1-3 words" },
    { "key": "item-1.title", "type": "text", "instruction": "Name of option A" },
    { "key": "item-1.price", "type": "text", "instruction": "Starting price string for option A" },
    { "key": "item-1.body", "type": "text", "instruction": "1-2 sentence description of option A" },
    { "key": "item-1.cta", "type": "link", "instruction": "Link to option A's page" },
    { "key": "item-1.title-repeat", "type": "text", "instruction": "Same value as item-1.title, repeated for the pros/cons column header" },
    { "key": "item-1.pros", "type": "list", "instruction": "3-4 short strengths of option A" },
    { "key": "item-1.cons", "type": "list", "instruction": "2-3 short tradeoffs of option A" },
    { "key": "item-2.image", "type": "image", "instruction": "Image URL for option B" },
    { "key": "item-2.subtitle", "type": "text", "instruction": "Category label for option B, 1-3 words" },
    { "key": "item-2.title", "type": "text", "instruction": "Name of option B" },
    { "key": "item-2.price", "type": "text", "instruction": "Starting price string for option B" },
    { "key": "item-2.body", "type": "text", "instruction": "1-2 sentence description of option B" },
    { "key": "item-2.cta", "type": "link", "instruction": "Link to option B's page" },
    { "key": "item-2.title-repeat", "type": "text", "instruction": "Same value as item-2.title, repeated for the pros/cons column header" },
    { "key": "item-2.pros", "type": "list", "instruction": "3-4 short strengths of option B" },
    { "key": "item-2.cons", "type": "list", "instruction": "2-3 short tradeoffs of option B" },
    { "key": "verdict.eyebrow", "type": "text", "instruction": "Short label, e.g. 'The verdict'" },
    { "key": "verdict.title", "type": "text", "instruction": "Headline framing the recommendation, <=8 words" },
    { "key": "verdict.body", "type": "text", "instruction": "1-2 sentence guidance on which to pick and when" },
    { "key": "cta.title", "type": "text", "instruction": "Closing headline, <=6 words" },
    { "key": "cta.subtitle", "type": "text", "instruction": "1-sentence supporting line" },
    { "key": "cta.cta-primary", "type": "link", "instruction": "Final CTA label + link" }
  ]
}
