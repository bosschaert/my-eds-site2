{
  "name": "of1-comparison-versus",
  "intent": "comparison",
  "description": "Head-to-head 1-vs-1 face-off between exactly two options, with a row-by-row breakdown and a verdict.",
  "minItems": 2,
  "maxItems": 2,
  "stylesheet": "/styles/of1-comparison-versus.css",
  "html": "/templates/of1-comparison-versus.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Small label above headline, 1-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline framing the head-to-head, <=8 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-2 sentence supporting line" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "Primary CTA label + link" },
    { "key": "hero.image", "type": "image", "instruction": "Hero image URL" },
    { "key": "item-1.image", "type": "image", "instruction": "Option A image URL" },
    { "key": "item-1.tag", "type": "text", "instruction": "Small label for option A, 1-2 words (e.g. Option A)" },
    { "key": "item-1.title", "type": "text", "instruction": "Option A name" },
    { "key": "item-1.body", "type": "text", "instruction": "1-2 sentence description of option A" },
    { "key": "item-1.cta", "type": "link", "instruction": "CTA label + link for option A" },
    { "key": "versus.label", "type": "text", "instruction": "Divider label between the two options, 1-2 chars (e.g. vs)" },
    { "key": "item-2.image", "type": "image", "instruction": "Option B image URL" },
    { "key": "item-2.tag", "type": "text", "instruction": "Small label for option B, 1-2 words (e.g. Option B)" },
    { "key": "item-2.title", "type": "text", "instruction": "Option B name" },
    { "key": "item-2.body", "type": "text", "instruction": "1-2 sentence description of option B" },
    { "key": "item-2.cta", "type": "link", "instruction": "CTA label + link for option B" },
    { "key": "breakdown.title", "type": "text", "instruction": "Breakdown section headline, <=4 words" },
    { "key": "breakdown.subtitle", "type": "text", "instruction": "1 sentence framing the breakdown" },
    { "key": "breakdown.row-1-label", "type": "text", "instruction": "Row 1 label, 1-3 words" },
    { "key": "breakdown.row-1-a", "type": "text", "instruction": "Row 1 value for option A, short" },
    { "key": "breakdown.row-1-b", "type": "text", "instruction": "Row 1 value for option B, short" },
    { "key": "breakdown.row-2-label", "type": "text", "instruction": "Row 2 label, 1-3 words" },
    { "key": "breakdown.row-2-a", "type": "text", "instruction": "Row 2 value for option A, short" },
    { "key": "breakdown.row-2-b", "type": "text", "instruction": "Row 2 value for option B, short" },
    { "key": "breakdown.row-3-label", "type": "text", "instruction": "Row 3 label, 1-3 words" },
    { "key": "breakdown.row-3-a", "type": "text", "instruction": "Row 3 value for option A, short" },
    { "key": "breakdown.row-3-b", "type": "text", "instruction": "Row 3 value for option B, short" },
    { "key": "breakdown.row-4-label", "type": "text", "instruction": "Row 4 label, 1-3 words" },
    { "key": "breakdown.row-4-a", "type": "text", "instruction": "Row 4 value for option A, short" },
    { "key": "breakdown.row-4-b", "type": "text", "instruction": "Row 4 value for option B, short" },
    { "key": "verdict.eyebrow", "type": "text", "instruction": "Small label, 1-3 words" },
    { "key": "verdict.title", "type": "text", "instruction": "Verdict headline, <=10 words" },
    { "key": "verdict.body", "type": "text", "instruction": "1-2 sentence closing verdict" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline, <=8 words" },
    { "key": "cta.subtitle", "type": "text", "instruction": "1 sentence closing line" },
    { "key": "cta.cta-primary", "type": "link", "instruction": "Closing CTA label + link" }
  ]
