{
  "name": "of1-recommendation-ranked-list",
  "intent": "recommendation",
  "description": "Numbered ranked list of 3-5 recommended products in row form, best fit first, with a supporting quote.",
  "minItems": 3,
  "maxItems": 5,
  "stylesheet": "/styles/of1-recommendation-ranked-list.css",
  "html": "/templates/of1-recommendation-ranked-list.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label, 2-4 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline, <=8 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-2 sentence framing of the ranking" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "CTA to view all products" },
    { "key": "intro.body", "type": "text", "instruction": "1-sentence note on ranking methodology" },
    { "key": "item-1.rank", "type": "text", "instruction": "Rank number, e.g. '1'" },
    { "key": "item-1.image", "type": "image", "instruction": "Product image" },
    { "key": "item-1.title", "type": "text", "instruction": "Product name" },
    { "key": "item-1.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-1.price", "type": "text", "instruction": "Price line, e.g. '$20/mo'" },
    { "key": "item-1.cta", "type": "link", "instruction": "Link to product page" },
    { "key": "item-2.rank", "type": "text", "instruction": "Rank number, e.g. '2'" },
    { "key": "item-2.image", "type": "image", "instruction": "Product image" },
    { "key": "item-2.title", "type": "text", "instruction": "Product name" },
    { "key": "item-2.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-2.price", "type": "text", "instruction": "Price line" },
    { "key": "item-2.cta", "type": "link", "instruction": "Link to product page" },
    { "key": "item-3.rank", "type": "text", "instruction": "Rank number, e.g. '3'" },
    { "key": "item-3.image", "type": "image", "instruction": "Product image" },
    { "key": "item-3.title", "type": "text", "instruction": "Product name" },
    { "key": "item-3.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-3.price", "type": "text", "instruction": "Price line" },
    { "key": "item-3.cta", "type": "link", "instruction": "Link to product page" },
    { "key": "item-4.rank", "type": "text", "instruction": "Rank number, e.g. '4'" },
    { "key": "item-4.image", "type": "image", "instruction": "Product image" },
    { "key": "item-4.title", "type": "text", "instruction": "Product name" },
    { "key": "item-4.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-4.price", "type": "text", "instruction": "Price line" },
    { "key": "item-4.cta", "type": "link", "instruction": "Link to product page" },
    { "key": "item-5.rank", "type": "text", "instruction": "Rank number, e.g. '5'" },
    { "key": "item-5.image", "type": "image", "instruction": "Product image" },
    { "key": "item-5.title", "type": "text", "instruction": "Product name" },
    { "key": "item-5.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-5.price", "type": "text", "instruction": "Price line" },
    { "key": "item-5.cta", "type": "link", "instruction": "Link to product page" },
    { "key": "quote.body", "type": "text", "instruction": "Short customer quote, 1 sentence, wrapped in quotes" },
    { "key": "quote.author", "type": "text", "instruction": "Name, role, company" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline, <=8 words" },
    { "key": "cta.link", "type": "link", "instruction": "Contact/sales CTA" }
  ]
}
