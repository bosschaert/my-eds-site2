{
  "name": "of1-recommendation-ranked-list",
  "intent": "recommendation",
  "description": "Numbered ranked list of 3-4 matches with the top pick visually emphasized, plus a rationale section.",
  "minItems": 3,
  "maxItems": 4,
  "stylesheet": "/styles/of1-recommendation-ranked-list.css",
  "html": "/templates/of1-recommendation-ranked-list.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label, e.g. 'Your ranked picks', 2-4 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline framing a ranked shortlist, <=10 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-sentence framing of how the list was ranked" },
    { "key": "hero.cta", "type": "link", "instruction": "Primary call to action" },
    { "key": "item-1.tag", "type": "text", "instruction": "Short tag for rank 1, e.g. 'Best match', <=3 words" },
    { "key": "item-1.image", "type": "image", "instruction": "Image for rank 1 item" },
    { "key": "item-1.title", "type": "text", "instruction": "Rank 1 item name, <=8 words" },
    { "key": "item-1.body", "type": "text", "instruction": "1-sentence description of rank 1 item" },
    { "key": "item-1.cta", "type": "link", "instruction": "CTA to start rank 1 item" },
    { "key": "item-2.tag", "type": "text", "instruction": "Short tag for rank 2, <=3 words" },
    { "key": "item-2.image", "type": "image", "instruction": "Image for rank 2 item" },
    { "key": "item-2.title", "type": "text", "instruction": "Rank 2 item name, <=8 words" },
    { "key": "item-2.body", "type": "text", "instruction": "1-sentence description of rank 2 item" },
    { "key": "item-2.cta", "type": "link", "instruction": "CTA to start rank 2 item" },
    { "key": "item-3.tag", "type": "text", "instruction": "Short tag for rank 3, <=3 words" },
    { "key": "item-3.image", "type": "image", "instruction": "Image for rank 3 item" },
    { "key": "item-3.title", "type": "text", "instruction": "Rank 3 item name, <=8 words" },
    { "key": "item-3.body", "type": "text", "instruction": "1-sentence description of rank 3 item" },
    { "key": "item-3.cta", "type": "link", "instruction": "CTA to start rank 3 item" },
    { "key": "item-4.tag", "type": "text", "instruction": "Short tag for rank 4, <=3 words" },
    { "key": "item-4.image", "type": "image", "instruction": "Image for rank 4 item" },
    { "key": "item-4.title", "type": "text", "instruction": "Rank 4 item name, <=8 words" },
    { "key": "item-4.body", "type": "text", "instruction": "1-sentence description of rank 4 item" },
    { "key": "item-4.cta", "type": "link", "instruction": "CTA to start rank 4 item" },
    { "key": "why.title", "type": "text", "instruction": "Section headline, e.g. 'How we ranked these'" },
    { "key": "why.body", "type": "text", "instruction": "1-2 sentence explanation of the ranking logic" },
    { "key": "why.caption", "type": "text", "instruction": "Short caption under the visual, <=3 words" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline, <=8 words" },
    { "key": "cta.subtitle", "type": "text", "instruction": "1-sentence supporting line" },
    { "key": "cta.button", "type": "link", "instruction": "Final CTA button" }
  ]
}
