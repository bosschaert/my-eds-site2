    { "key": "item-2.features", "type": "list", "instruction": "4 short values matching table.row-labels order" },
    { "key": "item-2.cta", "type": "link", "instruction": "Link to product page" },
    { "key": "item-3.image", "type": "image", "instruction": "Product image URL" },
    { "key": "item-3.subtitle", "type": "text", "instruction": "Category label, 1-3 words" },
    { "key": "item-3.title", "type": "text", "instruction": "Product name" },
    { "key": "item-3.price", "type": "text", "instruction": "Starting price string, e.g. $20/mo" },
    { "key": "item-3.features", "type": "list", "instruction": "4 short values matching table.row-labels order" },
    { "key": "item-3.cta", "type": "link", "instruction": "Link to product page" },
    { "key": "item-4.image", "type": "image", "instruction": "Product image URL" },
    { "key": "item-4.subtitle", "type": "text", "instruction": "Category label, 1-3 words" },
    { "key": "item-4.title", "type": "text", "instruction": "Product name" },
    { "key": "item-4.price", "type": "text", "instruction": "Starting price string, e.g. $20/mo" },
    { "key": "item-4.features", "type": "list", "instruction": "4 short values matching table.row-labels order" },
    { "key": "item-4.cta", "type": "link", "instruction": "Link to product page" },
    { "key": "insight-1.title", "type": "text", "instruction": "Short insight headline" },
    { "key": "insight-1.body", "type": "text", "instruction": "1-2 sentence insight explaining a key differentiator" },
    { "key": "insight-2.title", "type": "text", "instruction": "Short insight headline" },
