{
  "name": "of1-comparison-table",
  "intent": "comparison",
  "description": "Dense side-by-side spec table with a shared row-label column for 2-4 products, plus insight callouts and FAQ.",
  "minItems": 2,
  "maxItems": 4,
  "stylesheet": "/styles/of1-comparison-table.css",
  "html": "/templates/of1-comparison-table.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label above the title, 1-3 words" },
    { "key": "hero.title", "type": "text", "instruction": "Comparison headline, <=9 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-sentence framing of what's being compared" },
    { "key": "hero.cta-primary", "type": "link", "instruction": "Primary CTA, e.g. Try it free" },
    { "key": "hero.cta-secondary", "type": "link", "instruction": "Secondary CTA, e.g. Talk to sales" },
    { "key": "table.row-labels", "type": "list", "instruction": "4 short row labels shared across all items, e.g. Best for, Starting price, Key strength, Deployment" },
    { "key": "item-1.image", "type": "image", "instruction": "Product image URL" },
    { "key": "item-1.subtitle", "type": "text", "instruction": "Category label, 1-3 words" },
    { "key": "item-1.title", "type": "text", "instruction": "Product name" },
    { "key": "item-1.price", "type": "text", "instruction": "Starting price string, e.g. $20/mo" },
    { "key": "item-1.features", "type": "list", "instruction": "4 short values matching table.row-labels order" },
    { "key": "item-1.cta", "type": "link", "instruction": "Link to product page" },
    { "key": "item-2.image", "type": "image", "instruction": "Product image URL" },
