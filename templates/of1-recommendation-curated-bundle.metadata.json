{
  "name": "of1-recommendation-curated-bundle",
  "intent": "recommendation",
  "description": "Tabbed bundle of 3 time-of-day picks plus a full grid summary — for recommending a set rather than a single item.",
  "minItems": 3,
  "maxItems": 3,
  "stylesheet": "/styles/of1-recommendation-curated-bundle.css",
  "html": "/templates/of1-recommendation-curated-bundle.html",
  "slots": [
    { "key": "hero.eyebrow", "type": "text", "instruction": "Short label, e.g. 'Your curated bundle', 2-4 words" },
    { "key": "hero.title", "type": "text", "instruction": "Headline framing a bundle of picks, <=10 words" },
    { "key": "hero.subtitle", "type": "text", "instruction": "1-sentence framing of why a bundle (not one pick) fits" },
    { "key": "hero.cta", "type": "link", "instruction": "Primary call to action" },
    { "key": "hero.image", "type": "image", "instruction": "Hero image URL" },
    { "key": "tabs.title", "type": "text", "instruction": "Section headline, e.g. 'Pick a moment'" },
    { "key": "tab-1.label", "type": "text", "instruction": "Tab label, <=2 words, e.g. 'Morning'" },
    { "key": "tab-1.image", "type": "image", "instruction": "Image for tab 1 panel" },
    { "key": "tab-1.title", "type": "text", "instruction": "Tab 1 pick name, <=8 words" },
    { "key": "tab-1.body", "type": "text", "instruction": "1-sentence description of tab 1 pick" },
    { "key": "tab-1.cta", "type": "link", "instruction": "CTA for tab 1 pick" },
    { "key": "tab-2.label", "type": "text", "instruction": "Tab label, <=2 words, e.g. 'Midday'" },
    { "key": "tab-2.image", "type": "image", "instruction": "Image for tab 2 panel" },
    { "key": "tab-2.title", "type": "text", "instruction": "Tab 2 pick name, <=8 words" },
    { "key": "tab-2.body", "type": "text", "instruction": "1-sentence description of tab 2 pick" },
    { "key": "tab-2.cta", "type": "link", "instruction": "CTA for tab 2 pick" },
    { "key": "tab-3.label", "type": "text", "instruction": "Tab label, <=2 words, e.g. 'Evening'" },
    { "key": "tab-3.image", "type": "image", "instruction": "Image for tab 3 panel" },
    { "key": "tab-3.title", "type": "text", "instruction": "Tab 3 pick name, <=8 words" },
    { "key": "tab-3.body", "type": "text", "instruction": "1-sentence description of tab 3 pick" },
    { "key": "tab-3.cta", "type": "link", "instruction": "CTA for tab 3 pick" },
    { "key": "grid.title", "type": "text", "instruction": "Section headline, e.g. 'The full bundle'" },
    { "key": "item-1.image", "type": "image", "instruction": "Bundle item 1 image" },
    { "key": "item-1.title", "type": "text", "instruction": "Bundle item 1 name, <=6 words" },
    { "key": "item-1.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-2.image", "type": "image", "instruction": "Bundle item 2 image" },
    { "key": "item-2.title", "type": "text", "instruction": "Bundle item 2 name, <=6 words" },
    { "key": "item-2.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "item-3.image", "type": "image", "instruction": "Bundle item 3 image" },
    { "key": "item-3.title", "type": "text", "instruction": "Bundle item 3 name, <=6 words" },
    { "key": "item-3.body", "type": "text", "instruction": "1-sentence description" },
    { "key": "cta.title", "type": "text", "instruction": "Closing CTA headline, <=8 words" },
    { "key": "cta.subtitle", "type": "text", "instruction": "1-sentence supporting line" },
    { "key": "cta.button", "type": "link", "instruction": "Final CTA button" }
  ]
}
